# Optional. Without these values PactFlow uses its clearly labeled simulation adapter.
SOLANA_RPC_URL=https://api.devnet.solana.com

# A funded Solana devnet keypair. Accepts either a JSON byte array or base58 secret key.
# Never commit a real secret key.
SOLANA_SECRET_KEY=
# Safer local alternative to SOLANA_SECRET_KEY. Do not use both.
SOLANA_KEYPAIR_PATH=

# Optional. Without a key, workflow generation uses the deterministic template.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
